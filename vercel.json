{
  "framework": null,
  "buildCommand": "echo no build step needed",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": { "maxDuration": 30 },
    "api/wvroofing/app.js": { "maxDuration": 300, "includeFiles": "db/wvroofing/**" }
  },
  "rewrites": [
    { "source": "/api/wvroofing/:path*", "destination": "/api/wvroofing/app?path=:path*" }
  ],
  "crons": [
    { "path": "/api/wvroofing/cron/daily", "schedule": "17 3 * * *" }
  ],
  "headers": [
    {
      "source": "/WVROOFING/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }]
    },
    {
      "source": "/WVROOFING",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }]
    }
  ]
}
