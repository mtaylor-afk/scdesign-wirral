{
  "name": "sc-design-construction",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "SC Design & Construction — premium design-led website + AI Extension Concept Visualiser",
  "scripts": {
    "dev": "next dev",
    "cms:sync": "node scripts/sync-cms-projects.mjs",
    "cms:setup": "node scripts/setup-projects-cms.mjs",
    "cms:test": "node --test scripts/tests/projects-queue.test.mjs scripts/tests/setup-projects-cms.test.mjs",
    "prebuild": "node scripts/sync-cms-projects.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "validate": "npm run typecheck && npm run lint && npm run build",
    "test:e2e": "playwright test",
    "wvr:test": "node scripts/wvroofing/run-tests.mjs",
    "wvr:check": "tsc -p tsconfig.wvroofing.json",
    "wvr:selftest": "node scripts/wvroofing/selftest.mjs",
    "wvr:qa": "node scripts/wvroofing/qa.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "next": "^16.2.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^4.0.0",
    "sharp": "^0.34.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
