# WV Roofing — environment variables (names only; NEVER put values in this file).
# Set real values in Vercel -> project scdesign-wirral -> Settings -> Environment Variables (Production),
# then redeploy. Claude never handles keys, tokens or passwords.
# The increment that first reads each variable is shown in brackets.

# --- Environment ------------------------------------------------------------
# "test" only in the labelled test environment (dev server, node --test): PGlite, local-folder storage,
# fixture adapters. Never set in production. [A1]
WVR_ENV=
# Test environment only: keep PGlite / local storage on disk instead of in memory/temp. [A1]
WVR_PGLITE_DIR=
WVR_FS_STORAGE_DIR=
# Test environment only: how the OpenAI stand-in answers (ok | timeout | network | 5xx | 5xx_once |
# 429_once | refused | budget | misaligned) and how long it takes. Ignored in production. [A3]
WVR_FIXTURE_OPENAI=
WVR_FIXTURE_LATENCY_MS=

# --- Storage (Neon + private Vercel Blob, both London) -----------------------
# Injected by Vercel when the Neon resource is connected (either name works; WVR_DATABASE_URL wins). [A1]
WVR_DATABASE_URL=
DATABASE_URL=
POSTGRES_URL=
# Injected by Vercel when the private Blob store is connected (OIDC); BLOB_READ_WRITE_TOKEN only for runs outside Vercel. [A1]
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# 64 random hex characters: keys the daily IP hashes and signs short-lived tokens. [A1]
WVR_SESSION_SECRET=
# Random string: Vercel sends it as "Authorization: Bearer ..." to the daily cron. [A1]
# REQUIRED for uploads: storage only counts as enabled when the daily retention job can run. [A2]
CRON_SECRET=

# --- Kill switch and capability switches ---------------------------------------
# "0" stops every paid outside call (renders, address lookups, maps). [existing]
WVR_ENABLED=
# Each capability needs its credential AND its switch set to "on" AND its rights resolved in
# serverlib/wvroofing/permissions.js. A key alone never switches anything on. [A1]
WVR_CAP_ADDRESS_LOOKUP=
WVR_CAP_AERIAL_DISPLAY=
WVR_CAP_IMAGE_GENERATION=
WVR_CAP_ENQUIRY_DELIVERY=
WVR_CAP_ASSISTED_MEASUREMENT=
WVR_CAP_OS_REFERENCE=
WVR_CAP_DESK_MEASURE=

# --- Photo-real renders (OpenAI) ------------------------------------------------
# Dedicated OpenAI project with a hard monthly budget. [existing]
WVR_OPENAI_API_KEY=
# Model and quality, validated per model; unknown models are refused (default gpt-image-2.5-sunburst, high). [A3]
WVR_IMAGE_MODEL=
WVR_IMAGE_QUALITY=
# JPEG compression OpenAI returns (default 90). [existing]
WVR_OUTPUT_COMPRESSION=
# How long one render may take, in ms (default 240000, at most 270000 inside the 300 s function). [A3]
WVR_OPENAI_TIMEOUT_MS=
# Finishes rendered automatically once the customer agrees (default 1; 0 = only when tapped). [A3]
WVR_AUTO_RENDER=
# Queued + running renders allowed per project (default 3). [A3]
WVR_MAX_CONCURRENT=
# Renders per minute sent to OpenAI across every instance (default 5 = Tier 1). [A3]
WVR_UPSTREAM_IPM=
# Renders per day: per visitor (default 40), per project (default 12), in total (default 200). [A3]
WVR_IP_DAILY=
WVR_RENDERS_PER_PROJECT_DAILY=
WVR_DAILY_CAP=
# Daily spend ceiling in US dollars, including renders still in flight (default 5). [A3]
WVR_DAILY_BUDGET_USD=
# Composites whose edges miss the photo by more than this (mean luma difference) are rejected (default 50, uncalibrated until A8). [A3]
WVR_MAX_SEAM=

# --- Uploads ----------------------------------------------------------------------
# Global cap on photo uploads per day (protects the Hobby Blob allowance; default 40). [A2]
WVR_DAILY_UPLOADS=
# New projects per visitor per day (default 20) and uploads per project per day (default 10). [A2]
WVR_PROJECTS_PER_IP_DAILY=
WVR_UPLOADS_PER_PROJECT_DAILY=
# Plans and drawings a customer may add per project per day (default 20; at most 10 kept). They also
# need WVR_CAP_ASSISTED_MEASUREMENT=on. [B3]
WVR_EVIDENCE_PER_PROJECT_DAILY=

# --- Enquiries ------------------------------------------------------------------
# Enquiries are always saved first (needs storage); emails also need WVR_CAP_ENQUIRY_DELIVERY=on. [A4]
# Inbox(es) for enquiry notifications, comma-separated. [existing]
WVR_LEAD_TO=
# From header; must be an address/alias on the SMTP account and must name "WV Roofing" (never
# SC Design), otherwise the default "WV Roofing (concept)" sender is used. [A4]
WVR_MAIL_FROM=
# "1" logs emails instead of sending them. [existing]
WVR_MAIL_DRYRUN=
# Enquiries per visitor per hour (default 5) and in total per day (default 200). [A4]
WVR_ENQUIRIES_PER_IP_HOURLY=
WVR_ENQUIRIES_DAILY=
# Shared iCloud SMTP login already set on the project. [existing]
SMTP_USER=
SMTP_PASS=

# --- Address lookup and aerial confirmation -----------------------------------------
# Ideal Postcodes (server-side key; set a daily lookup limit in their dashboard). [A5]
WVR_IDEAL_POSTCODES_KEY=
# Google Maps Static API key (restricted to our referrers) + URL-signing secret. [A5]
WVR_GOOGLE_MAPS_STATIC_KEY=
WVR_GOOGLE_MAPS_SIGNING_SECRET=
# Paid-call limits. Address lookups: per project (default 10), per visitor (30), per day (300). [A5]
WVR_ADDRESS_LOOKUPS_PER_PROJECT=
WVR_ADDRESS_LOOKUPS_PER_IP=
WVR_ADDRESS_LOOKUPS_DAILY=
# Satellite views: per project (default 20), per visitor (60), per day (300). [A5]
WVR_MAP_VIEWS_PER_PROJECT=
WVR_MAP_VIEWS_PER_IP=
WVR_MAP_VIEWS_DAILY=

# --- Operator screen ----------------------------------------------------------------
# The "scrypt:..." line printed by: node scripts/wvroofing/operator-hash.mjs (you type the password; it is
# never stored). Without it the operator login says it isn't set up. A new hash logs every session out. [A6]
WVR_OPERATOR_PASSWORD_HASH=

# --- Release B (optional, operator-only) ------------------------------------------------
# OS Data Hub Premium key (first GBP 1,000/month free); operator reference panel / desk tool. [B3b/B5]
WVR_OS_DATAHUB_KEY=

# --- Origins ---------------------------------------------------------------------------
# Extra browser origins allowed to call the API (comma-separated). [existing]
WVR_EXTRA_ORIGINS=
