# WV Roofing — environment variables (names only; NEVER put values in this file).
# Set real values in Vercel -> project scdesign-wirral -> Settings -> Environment Variables (Production),
# then redeploy. Claude never handles keys, tokens or passwords.
# The increment that first reads each variable is shown in brackets.

# --- Environment ------------------------------------------------------------
# "test" only in the labelled test environment (dev server, node --test): PGlite, local-folder storage,
# fixture adapters. Never set in production. [A1]
WVR_ENV=
# Test environment only: keep PGlite / local storage on disk instead of in memory/temp. [A1]
WVR_PGLITE_DIR=
WVR_FS_STORAGE_DIR=

# --- Storage (Neon + private Vercel Blob, both London) -----------------------
# Injected by Vercel when the Neon resource is connected (either name works; WVR_DATABASE_URL wins). [A1]
WVR_DATABASE_URL=
DATABASE_URL=
POSTGRES_URL=
# Injected by Vercel when the private Blob store is connected (OIDC); BLOB_READ_WRITE_TOKEN only for runs outside Vercel. [A1]
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# 64 random hex characters: keys the daily IP hashes and signs short-lived tokens. [A1]
WVR_SESSION_SECRET=
# Random string: Vercel sends it as "Authorization: Bearer ..." to the daily cron. [A1]
# REQUIRED for uploads: storage only counts as enabled when the daily retention job can run. [A2]
CRON_SECRET=

# --- Kill switch and capability switches ---------------------------------------
# "0" stops every paid outside call (renders, address lookups, maps). [existing]
WVR_ENABLED=
# Each capability needs its credential AND its switch set to "on" AND its rights resolved in
# serverlib/wvroofing/permissions.js. A key alone never switches anything on. [A1]
WVR_CAP_ADDRESS_LOOKUP=
WVR_CAP_AERIAL_DISPLAY=
WVR_CAP_IMAGE_GENERATION=
WVR_CAP_ENQUIRY_DELIVERY=
WVR_CAP_ASSISTED_MEASUREMENT=
WVR_CAP_OS_REFERENCE=
WVR_CAP_DESK_MEASURE=

# --- Photo-real renders (OpenAI) ------------------------------------------------
# Dedicated OpenAI project with a hard monthly budget. [existing]
WVR_OPENAI_API_KEY=
WVR_IMAGE_MODEL=
WVR_IMAGE_QUALITY=
WVR_OUTPUT_COMPRESSION=
WVR_OPENAI_TIMEOUT_MS=
WVR_AUTO_RENDER=
WVR_MAX_CONCURRENT=
WVR_UPSTREAM_IPM=
WVR_IP_LIMIT=
WVR_IP_DAILY=
WVR_DAILY_CAP=
WVR_ALLOW_MOCK=
# Daily spend ceiling in US dollars, including renders still in flight. [A3]
WVR_DAILY_BUDGET_USD=

# --- Uploads ----------------------------------------------------------------------
# Global cap on photo uploads per day (protects the Hobby Blob allowance; default 40). [A2]
WVR_DAILY_UPLOADS=
# New projects per visitor per day (default 20) and uploads per project per day (default 10). [A2]
WVR_PROJECTS_PER_IP_DAILY=
WVR_UPLOADS_PER_PROJECT_DAILY=

# --- Enquiries ------------------------------------------------------------------
# Inbox(es) for enquiry notifications, comma-separated. [existing]
WVR_LEAD_TO=
# From header; must be an address/alias on the SMTP account. Always "WV Roofing", never SC Design. [existing]
WVR_MAIL_FROM=
# "1" logs emails instead of sending them (tests). [existing]
WVR_MAIL_DRYRUN=
# Shared iCloud SMTP login already set on the project. [existing]
SMTP_USER=
SMTP_PASS=

# --- Address lookup and aerial confirmation -----------------------------------------
# Ideal Postcodes (server-side key; set a daily lookup limit in their dashboard). [A5]
WVR_IDEAL_POSTCODES_KEY=
# Google Maps Static API key (restricted to our referrers) + URL-signing secret. [A5]
WVR_GOOGLE_MAPS_STATIC_KEY=
WVR_GOOGLE_MAPS_SIGNING_SECRET=

# --- Operator screen ----------------------------------------------------------------
# scrypt hash printed by: node scripts/wvroofing/operator-hash.mjs (you type the password; it is never stored). [A6]
WVR_OPERATOR_PASSWORD_HASH=

# --- Release B (optional, operator-only) ------------------------------------------------
# OS Data Hub Premium key (first GBP 1,000/month free); operator reference panel / desk tool. [B3b/B5]
WVR_OS_DATAHUB_KEY=

# --- Origins ---------------------------------------------------------------------------
# Extra browser origins allowed to call the API (comma-separated). [existing]
WVR_EXTRA_ORIGINS=
