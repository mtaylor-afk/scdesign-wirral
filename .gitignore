# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit real secrets)
.env
.env*.local
.env.local

# Local push/deploy helpers — NEVER commit. One of these holds a GitHub token,
# and this repo is public: a committed token is published and auto-revoked.
# They were untracked but unignored, so a single `git add -A` would have staged
# them. Patterns are deliberately broad.
*token*.txt
*TOKEN*.txt
/_deploy-*.cmd
/_deploy-*.txt
/_push*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts.bak

# testing
/test-results/
/playwright-report/
/playwright/.cache/
