# Production build flags for the standalone SC Design Wirral site (Cloudflare Pages).
# Static export at the domain root, indexable, forms use the email/WhatsApp fallback.
NEXT_PUBLIC_STATIC=1
NEXT_PUBLIC_SITE_URL=https://scdesignwirral.co.uk
# Live domain is indexable — leave NEXT_PUBLIC_NOINDEX unset (set to 1 only for previews).
# Paste the Google review URL here once the Business Profile is verified (blank = placeholder shown):
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# AI Extension Concept Visualiser — SC-only V4 backend (classify → analyse → generate
# from the original photo → validate → retry/safe-fail). Rollback: set this back to
# https://q-cbuild1.vercel.app/api/sc-visualise (the untouched legacy endpoint).
NEXT_PUBLIC_SC_VISUALISER_ENDPOINT=https://q-cbuild1.vercel.app/api/sc-visualise-v4

# First-party cookieless analytics backend (SC-only Vercel project + Supabase).
# Base origin only; the tracker appends /api/sc-analytics-collect and the admin
# app appends /api/sc-admin-*. Update this if the Vercel production domain differs.
NEXT_PUBLIC_SC_ANALYTICS_BASE=https://scdesign-wirral.vercel.app
