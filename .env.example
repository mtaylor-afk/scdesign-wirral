# ============================================================
# SC Design & Construction — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ============================================================

# --- Public site config (safe to expose) ---
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search indexing: set to 1 ONLY for preview / non-production builds to emit
# noindex,nofollow. Leave unset/blank on the live own-domain deploy.
NEXT_PUBLIC_NOINDEX=

# Google review link — paste the live "leave a review" URL once the Google
# Business Profile is verified. Blank → the site shows a placeholder, never a
# broken link. Never pair with invented reviews / AggregateRating schema.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# --- Analytics (Plausible — consent-gated, cookieless) ---
# Leave blank to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Cloudflare Turnstile (spam protection) ---
# Public site key is exposed to the browser; secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase (server-side: leads, visualiser jobs, rate limits, storage) ---
# URL + anon key are safe-ish; the SERVICE ROLE KEY is server-only and must
# NEVER be exposed to the client. Leave blank in dev to use graceful fallbacks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VISUALISER_BUCKET=visualiser-results

# --- Resend (transactional lead emails) ---
RESEND_API_KEY=
# Where lead + visualiser-concept notifications are sent:
LEAD_NOTIFICATION_EMAIL=scdesignandconstruction1@gmail.com
# Verified sender (must be a Resend-verified domain/address in production):
LEAD_FROM_EMAIL=SC Design & Construction <onboarding@resend.dev>

# --- iCloud SMTP mailer for enquiry notifications (api/sc-enquiry-backup.js) ---
# REQUIRED for website enquiries to be EMAILED to Sean/Matthew. Server-side
# notification email for EVERY website enquiry, sent independently of the external
# q-cbuild1 endpoint (mirrors the TailoredQuote mailer framework). Set these in the
# SC `scdesign-wirral` Vercel project, then REDEPLOY (env changes need a redeploy).
# If unset, sc-enquiry-backup returns emailError:"smtp_not_configured" and NO email
# is sent (this is the cause of "enquiries aren't reaching my inbox").
#   SMTP_USER — the iCloud account email that authenticates + sends.
#   SMTP_PASS — an APP-SPECIFIC password for that account (appleid.apple.com →
#               Sign-In and Security → App-Specific Passwords). NOT the login password.
SMTP_USER=
SMTP_PASS=
# From header — MUST be an address/alias that belongs to the SMTP_USER iCloud
# account, or iCloud rejects the send. If you authenticate as your own iCloud
# (e.g. matthewjtaylor1985@icloud.com), set this to that same address, e.g.
#   SC_MAIL_FROM=SC Design Wirral <matthewjtaylor1985@icloud.com>
# Only keep the tailoredquote.co.uk From if SMTP_USER owns that alias.
SC_MAIL_FROM=SC Design Wirral <mail@tailoredquote.co.uk>
# Recipients. Sean's business address goes in To; Matthew is CC'd:
SC_LEAD_TO=scdesignandconstruction1@gmail.com
SC_LEAD_CC=matthewjtaylor1985@icloud.com
# Legacy alternative (comma-separated; first = To, rest = Cc). Only used if
# SC_LEAD_TO is unset. Code default matches SC_LEAD_TO/SC_LEAD_CC above.
# SC_LEAD_RECIPIENTS=scdesignandconstruction1@gmail.com,matthewjtaylor1985@icloud.com

# --- SC first-party analytics + admin + error logging (Vercel: scdesign-wirral) ---
# The SC-isolated analytics/admin/error stack (serverlib/common.js + api/sc-*.js)
# reads its OWN SC_-prefixed vars — DISTINCT from the NEXT_PUBLIC_SUPABASE_* /
# SUPABASE_SERVICE_ROLE_KEY above (those are the q-cbuild1 names). Set these in the
# SC `scdesign-wirral` Vercel project. Without SC_SUPABASE_*, no enquiry/event/
# error is stored at all.
SC_SUPABASE_URL=
SC_SUPABASE_SERVICE_ROLE_KEY=
# Admin /admin portal credentials + the HMAC session / daily analytics salt.
# SC_ADMIN_SESSION_SECRET is REQUIRED: requireSession() fails closed without it,
# and visitorHash() returns the 'anon' sentinel (no IP-derivable hash) when unset.
SC_ADMIN_USER=
SC_ADMIN_PASS=
SC_ADMIN_SESSION_SECRET=

# --- Projects CMS (admin → Content → Projects) ---
# Lets Sean write and publish case studies himself. Two stores are involved and
# the split matters: Supabase (SC_SUPABASE_* above) is the EDITING workbench —
# drafts, staged photos, the audit trail — while PUBLISHING commits
# content/projects/<slug>.json + public/work/cms/<slug>/* into the GitHub repo,
# which makes Cloudflare Pages rebuild. The live site reads the committed files,
# never Supabase, which is what keeps every case study prerendered and indexable.
#
# SC_GITHUB_TOKEN — REQUIRED for publishing, and the one credential that has to be
#   created by hand. A GitHub **fine-grained** personal access token, scoped to the
#   single repository below, with **Contents: Read and write** and nothing else.
#   Set it in the SC `scdesign-wirral` Vercel project only; it must never be
#   committed (this repo is public — a committed token is published and revoked).
#   ⚠ Fine-grained PATs EXPIRE (max one year). When it lapses, publishing stops
#   with "the publishing token is invalid or has expired" and Sean cannot update
#   the site until it is replaced. Diary the expiry date, or use a GitHub App
#   installation token instead, which does not expire.
#   Without this var the admin still saves drafts; only publishing is disabled.
SC_GITHUB_TOKEN=
SC_GITHUB_REPO=mtaylor-afk/scdesign-wirral
SC_GITHUB_BRANCH=main
# Private Supabase Storage bucket holding staged photos before they are published.
# Created by db/sc_projects.sql. Private on purpose: it is a workbench, not a CDN —
# published images are served from Cloudflare out of the repo, and nothing
# unpublished is ever publicly reachable.
SC_PROJECT_MEDIA_BUCKET=project-media

# --- AI Extension Concept Visualiser ---
#
# PRIMARY (photoreal, live): the static SC site POSTs the uploaded photo + form
# fields to a dedicated serverless endpoint that calls OpenAI gpt-image-1 with a
# server-side key and returns the render. The endpoint (api/sc-visualise.js)
# runs on the existing Vercel project and reuses its OPENAI_API_KEY — nothing to
# set here for the live site. Override only if the endpoint ever moves
# (build-time public var, baked into the static export):
NEXT_PUBLIC_SC_VISUALISER_ENDPOINT=https://q-cbuild1.vercel.app/api/sc-visualise
#
# If the endpoint is unreachable / rate-limited / refuses a photo, the browser
# falls back to a watermarked in-browser concept overlay so the page never
# breaks. The OpenAI key is NEVER exposed to the browser.
#
# LEGACY (optional Gemini path for a future standalone SC Vercel deploy via
# src/app/api/visualise/route.ts — unused by the static site):
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Enquiry (lead-capture) endpoint ---
# The multi-step contact form POSTs to a dedicated serverless endpoint
# (api/sc-enquiry.js, same Vercel project as the visualiser) which emails Sean
# instantly (reply-to = enquirer) and sends the enquirer an auto-acknowledgement.
# Reuses the shared SMTP_USER/SMTP_PASS mailer — nothing to set here for the live
# site. Optional Cloudflare Turnstile hardens it when TURNSTILE_SECRET_KEY is set
# server-side (+ NEXT_PUBLIC_TURNSTILE_SITE_KEY here). If the POST ever fails the
# browser falls back to a pre-filled mailto so a lead is never lost. Override
# only if the endpoint moves (build-time public var, baked into the export):
NEXT_PUBLIC_SC_ENQUIRY_ENDPOINT=https://q-cbuild1.vercel.app/api/sc-enquiry

# --- Visualiser limits / retention ---
VISUALISER_DAILY_CAP=200
VISUALISER_PER_IP_CAP=5
VISUALISER_RESULT_EXPIRY_DAYS=7
