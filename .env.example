# ============================================================
# SC Design & Construction — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ============================================================

# --- Public site config (safe to expose) ---
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search indexing: set to 1 ONLY for preview / non-production builds to emit
# noindex,nofollow. Leave unset/blank on the live own-domain deploy.
NEXT_PUBLIC_NOINDEX=

# Google review link — paste the live "leave a review" URL once the Google
# Business Profile is verified. Blank → the site shows a placeholder, never a
# broken link. Never pair with invented reviews / AggregateRating schema.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# --- Analytics (Plausible — consent-gated, cookieless) ---
# Leave blank to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Cloudflare Turnstile (spam protection) ---
# Public site key is exposed to the browser; secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase (server-side: leads, visualiser jobs, rate limits, storage) ---
# URL + anon key are safe-ish; the SERVICE ROLE KEY is server-only and must
# NEVER be exposed to the client. Leave blank in dev to use graceful fallbacks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VISUALISER_BUCKET=visualiser-results

# --- Resend (transactional lead emails) ---
RESEND_API_KEY=
# Where lead + visualiser-concept notifications are sent:
LEAD_NOTIFICATION_EMAIL=scdesignandconstruction1@gmail.com
# Verified sender (must be a Resend-verified domain/address in production):
LEAD_FROM_EMAIL=SC Design & Construction <onboarding@resend.dev>

# --- iCloud SMTP backup mailer (api/sc-enquiry-backup.js) ---
# Server-side notification email for EVERY website enquiry, sent independently of
# the external q-cbuild1 endpoint (mirrors the TailoredQuote mailer framework).
# Set these in the SC `scdesign-wirral` Vercel project — either the SAME iCloud
# creds the TailoredQuote backend uses, or an SC-owned iCloud+ account. If unset,
# enquiries still store in SQL + still hit the external endpoint; only this
# extra backup email is skipped.
SMTP_USER=
SMTP_PASS=
# From header — MUST be an address/alias on the SMTP_USER iCloud account.
SC_MAIL_FROM=SC Design Wirral <mail@tailoredquote.co.uk>
# Notification recipients (comma-separated). Defaults in code to the two below.
SC_LEAD_RECIPIENTS=scdesignandconstruction1@gmail.com,matthewjtaylor1985@icloud.com

# --- AI Extension Concept Visualiser ---
#
# PRIMARY (photoreal, live): the static SC site POSTs the uploaded photo + form
# fields to a dedicated serverless endpoint that calls OpenAI gpt-image-1 with a
# server-side key and returns the render. The endpoint (api/sc-visualise.js)
# runs on the existing Vercel project and reuses its OPENAI_API_KEY — nothing to
# set here for the live site. Override only if the endpoint ever moves
# (build-time public var, baked into the static export):
NEXT_PUBLIC_SC_VISUALISER_ENDPOINT=https://q-cbuild1.vercel.app/api/sc-visualise
#
# If the endpoint is unreachable / rate-limited / refuses a photo, the browser
# falls back to a watermarked in-browser concept overlay so the page never
# breaks. The OpenAI key is NEVER exposed to the browser.
#
# LEGACY (optional Gemini path for a future standalone SC Vercel deploy via
# src/app/api/visualise/route.ts — unused by the static site):
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Enquiry (lead-capture) endpoint ---
# The multi-step contact form POSTs to a dedicated serverless endpoint
# (api/sc-enquiry.js, same Vercel project as the visualiser) which emails Sean
# instantly (reply-to = enquirer) and sends the enquirer an auto-acknowledgement.
# Reuses the shared SMTP_USER/SMTP_PASS mailer — nothing to set here for the live
# site. Optional Cloudflare Turnstile hardens it when TURNSTILE_SECRET_KEY is set
# server-side (+ NEXT_PUBLIC_TURNSTILE_SITE_KEY here). If the POST ever fails the
# browser falls back to a pre-filled mailto so a lead is never lost. Override
# only if the endpoint moves (build-time public var, baked into the export):
NEXT_PUBLIC_SC_ENQUIRY_ENDPOINT=https://q-cbuild1.vercel.app/api/sc-enquiry

# --- Visualiser limits / retention ---
VISUALISER_DAILY_CAP=200
VISUALISER_PER_IP_CAP=5
VISUALISER_RESULT_EXPIRY_DAYS=7
