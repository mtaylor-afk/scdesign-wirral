# Plausible Community Edition config for SC Design Wirral analytics.
# Copy to `plausible-conf.env` inside the cloned plausible/community-edition repo
# and fill in the two secrets. See ./README.md for the full runbook.

BASE_URL=https://analytics.scdesignwirral.co.uk

# Secrets — generate and paste (do NOT commit real values):
#   SECRET_KEY_BASE : openssl rand -base64 48
#   TOTP_VAULT_KEY  : openssl rand -base64 32
SECRET_KEY_BASE=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48
TOTP_VAULT_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32

# Let the FIRST user self-register via /register, then set this to true + restart.
DISABLE_REGISTRATION=false
# No SMTP configured? keep verification off so you can create the first user
# without a confirmation email.
ENABLE_EMAIL_VERIFICATION=false

# App listen port (the reverse proxy / tunnel forwards to plausible:8000).
HTTP_PORT=8000

# Database URLs — these match the service names in the official compose.yml.
# Only change if you customise the compose.
DATABASE_URL=postgres://postgres:postgres@plausible_db:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db

# --- Optional: SMTP (password resets, invites, email reports) ---
# MAILER_EMAIL=analytics@scdesignwirral.co.uk
# SMTP_HOST_ADDR=smtp.example.com
# SMTP_HOST_PORT=587
# SMTP_USER_NAME=
# SMTP_USER_PWD=
